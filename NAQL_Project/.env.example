# OpenRouter API key used ONLY by server-side API routes (app/api/ai/*).
# It is never imported into client components and never sent to the browser.
# Get a key from https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: override the default OpenRouter model used for AI comparisons and the assistant.
# OPENROUTER_MODEL=openai/gpt-4o-mini
